# Doublures MSW (src/mocks/).
#   off     : aucune doublure — vraie API (défaut de `pnpm dev` et de la production)
#   partial : seules les routes non encore livrées par le back-end sont simulées (liste `undelivered`
#             de src/mocks/handlers/index.ts — vide aujourd'hui : équivaut à `off`)
#   full    : tout est simulé, y compris la connexion (démo sans back-end ; admin@honowa.tech / admin-dev-only)
VITE_MOCKS=off

# Préfixe de l'API vu du navigateur (défaut : /api/v1 ; fixé par l'image Docker du front).
# VITE_API_BASE_URL=/api/v1

# Gabarit d'URL des tuiles raster du fond de carte ({z}/{x}/{y}). Vide = carte sans fond (repli lisible).
# Exemple : https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILES_URL=
# Mention de source affichée sur la carte quand des tuiles sont configurées.
VITE_TILES_ATTRIBUTION=© contributeurs OpenStreetMap

# Cible du proxy de développement pour /api (défaut : http://localhost:8000).
# VITE_API_PROXY=http://localhost:8000
