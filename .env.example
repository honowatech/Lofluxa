# Copier en `.env` et adapter. Aucun secret réel ne doit être versionné.
TOURNEO_ENV=dev
TOURNEO_DATABASE_URL=postgresql+psycopg://tourneo:tourneo@localhost:5432/tourneo
TOURNEO_REDIS_URL=redis://localhost:6379/0
TOURNEO_OSRM_URL=http://localhost:5000
TOURNEO_JWT_SECRET=change-me-in-production
TOURNEO_CORS_ORIGINS=["http://localhost:5173"]
TOURNEO_SMTP_HOST=localhost
TOURNEO_SMTP_PORT=1025
TOURNEO_SMTP_FROM=tourneo@example.com
TOURNEO_ADMIN_EMAIL=admin@honowa.tech
TOURNEO_ADMIN_PASSWORD=admin-dev-only
