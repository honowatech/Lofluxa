# Tournéo — variables d'environnement. Copier en `.env` et adapter.
# Aucun secret réel ne doit être versionné : `.env` est ignoré par git.
#
# Générer un secret :  openssl rand -hex 32

# ─── Application (lu par l'API et le worker) ────────────────────────────────────────────────────────
# dev | test | prod. En `prod`, l'API refuse de démarrer avec un secret ou un mot de passe par défaut.
TOURNEO_ENV=dev
# Secret de signature des jetons JWT (au moins 32 caractères en production).
TOURNEO_JWT_SECRET=change-me-in-production
# Origines autorisées (CORS), liste JSON. En production : l'adresse publique, p. ex. ["https://tourneo.exemple.cm"]
TOURNEO_CORS_ORIGINS=["http://localhost:5173"]
# Compte administrateur créé au premier démarrage (mot de passe à changer ensuite dans l'application).
TOURNEO_ADMIN_EMAIL=admin@honowa.tech
TOURNEO_ADMIN_PASSWORD=admin-dev-only
# Envoi des fiches de chargement par e-mail.
TOURNEO_SMTP_HOST=localhost
TOURNEO_SMTP_PORT=1025
TOURNEO_SMTP_USER=
TOURNEO_SMTP_PASSWORD=
TOURNEO_SMTP_FROM=tourneo@example.com
TOURNEO_SMTP_TLS=false
# Limitation de débit des routes d'authentification (format « nombre/période », par adresse IP).
TOURNEO_RATE_LIMIT_ENABLED=true
TOURNEO_RATE_LIMIT_LOGIN=10/minute
TOURNEO_RATE_LIMIT_AUTH=60/minute
TOURNEO_PASSWORD_MIN_LENGTH=8

# ─── Développement sans Docker uniquement (docker-compose.yml impose ses propres adresses internes) ──
TOURNEO_DATABASE_URL=postgresql+psycopg://tourneo:tourneo@localhost:5432/tourneo
TOURNEO_REDIS_URL=redis://localhost:6379/0
TOURNEO_OSRM_URL=http://localhost:5000

# ─── Docker Compose : base de données ───────────────────────────────────────────────────────────────
POSTGRES_USER=tourneo
# Lettres et chiffres uniquement (le mot de passe est inséré dans une URL) : openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=tourneo

# ─── Docker Compose : accès web (Caddy) ─────────────────────────────────────────────────────────────
# Nom de domaine public (HTTPS automatique Let's Encrypt), `localhost` (certificat interne) ou `:80` (HTTP seul).
SITE_ADDRESS=localhost
# Adresse de contact Let's Encrypt (facultative). `internal` force un certificat interne auto-signé.
ACME_EMAIL=
# Nombre de processus de l'API et de calculs simultanés du worker.
API_WORKERS=2
WORKER_CONCURRENCY=2

# ─── Docker Compose : sauvegardes ───────────────────────────────────────────────────────────────────
# Phrase secrète de chiffrement (16 caractères au minimum). À CONSERVER HORS DU SERVEUR :
# sans elle, aucune sauvegarde n'est restaurable.
BACKUP_PASSPHRASE=
BACKUP_TIME=02:00
BACKUP_TZ=Africa/Douala
BACKUP_RETENTION_DAYS=14
# Copie hebdomadaire hors serveur (rclone). Laisser RCLONE_REMOTE vide pour la désactiver.
# Les identifiants du stockage se placent dans un fichier séparé `.env.backup` (non versionné, lu par le
# seul service `backup`). Exemple pour un stockage compatible S3 — le nom « offsite » relie les deux :
#   ici          : RCLONE_REMOTE=offsite:nom-du-bucket/tourneo
#   .env.backup  : RCLONE_CONFIG_OFFSITE_TYPE=s3
#                  RCLONE_CONFIG_OFFSITE_PROVIDER=Other
#                  RCLONE_CONFIG_OFFSITE_ENDPOINT=https://s3.exemple.com
#                  RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=...
#                  RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=...
RCLONE_REMOTE=
# Jour de la copie hors serveur : 1 = lundi … 7 = dimanche.
BACKUP_OFFSITE_WEEKDAY=7
# Durée de conservation hors serveur en jours (0 = illimitée).
BACKUP_OFFSITE_RETENTION_DAYS=0

# ─── Docker Compose : OSRM (calcul d'itinéraires, profil camion) ────────────────────────────────────
OSRM_PBF_URL=https://download.geofabrik.de/africa/cameroon-latest.osm.pbf
# mld (prétraitement rapide) ou ch.
OSRM_ALGORITHM=mld
OSRM_MAX_TABLE_SIZE=1000
# Profil camion : coefficient appliqué aux vitesses voiture, vitesse maximale, gabarit.
# Toute modification demande un nouveau prétraitement (infra/osrm/refresh.sh).
TRUCK_SPEED_FACTOR=0.8
TRUCK_MAX_SPEED_KMH=80
TRUCK_HEIGHT_M=4.0
TRUCK_WIDTH_M=2.55
TRUCK_LENGTH_M=16.5
TRUCK_WEIGHT_KG=40000
# 1 = écarter les voies interdites aux matières dangereuses (hazmat=no).
TRUCK_HAZMAT=1
