# Caddy — point d'entrée unique de Tournéo.
#
# SITE_ADDRESS : nom de domaine public (HTTPS automatique par Let's Encrypt), « localhost » pour une
#                démonstration (certificat interne auto-signé), ou « :80 » pour du HTTP seul.
# CADDY_TLS    : ligne de configuration TLS facultative, construite par docker-compose.yml à partir
#                d'ACME_EMAIL : vide (réglage automatique), « tls contact@exemple.cm » (adresse de
#                contact Let's Encrypt) ou « tls internal » (certificat interne).

{$SITE_ADDRESS:localhost} {
	{$CADDY_TLS}

	encode zstd gzip

	log {
		output stdout
		format json
	}

	# En-têtes de sécurité communs à toutes les réponses.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# API : tout ce qui commence par /api/ part vers FastAPI.
	@api path /api/*
	handle @api {
		request_body {
			max_size 25MB
		}
		reverse_proxy api:8000 {
			# Pendant un redémarrage de l'API (mise à jour), la requête est retentée au lieu d'échouer.
			lb_try_duration 15s
			lb_try_interval 500ms
			transport http {
				dial_timeout 5s
				response_header_timeout 120s
			}
		}
	}

	# Interface : fichiers statiques du build Vite, avec repli sur index.html (routes de la SPA).
	handle {
		root * /srv/www

		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https:; worker-src 'self' blob:; child-src blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

		# Les fichiers du dossier assets/ portent une empreinte dans leur nom : cache long (s'ils existent).
		@assets {
			path /assets/*
			file
		}
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# Le reste (index.html en tête) est toujours revalidé pour qu'une mise à jour soit visible aussitôt.
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"

		# Repli SPA : toute route inconnue hors assets/ renvoie index.html ; un fichier d'assets/ absent reste un 404.
		@spa {
			not path /assets/*
			file {
				try_files {path} /index.html
			}
		}
		rewrite @spa {http.matchers.file.relative}
		file_server
	}
}
